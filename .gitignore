# 用户本地配置（含 deploy.remote_url 等私有信息），不入库
config.yaml

# 构建产物（output/ 内含部署用 .git 仓库，单独管理）
output/

# Python
__pycache__/
*.py[cod]
.venv/

# 系统文件
.DS_Store

# 自动生成的 GitHub Actions 工作流（不入库，可按需手动 git add -f 提交）
.github/workflows/fastblog.yml

# 设计文档等本地资料，不入库
docs/

# 文章与图片资源不入库（仅本地构建，通过 deploy 命令发布到博客仓库）
content/
themes/**/static/**/*.{png,jpg,jpeg,gif,svg,webp,bmp,ico}

# Windows 本地构建环境
.venv-win/
